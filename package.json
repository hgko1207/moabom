    "draft-groups": "node --env-file-if-exists=.env scripts/fetch.ts draft-groups"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "pretendard": "^1.3.9"
  }
}
